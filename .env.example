# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.

# LSEG Workspace / Eikon application key (Workspace > App Key Generator). Used for the desktop
# session of the LSEG Data Library; requires the Workspace desktop app running and logged in.
EIKON_APP_KEY=

# Optional: key for the separate LSEG Vessel Tracking API (the Eikon app key does not apply).
VESSEL_TRACKING_API_KEY=
